    "webos": {
      "gpl": false,
      "configureFlags": [
        "--enable-network",
        "--enable-openssl"
      ],
      "hardwareAccelerators": [],
      "protocols": []
    },
    "windows": {
      "gpl": false,
      "configureFlags": [
        "--enable-network",
        "--enable-schannel"
      ],
      "hardwareAccelerators": [
        "av1_d3d11va",
        "av1_dxva2",
        "h264_d3d11va",
        "h264_dxva2",
        "hevc_d3d11va",
        "hevc_dxva2",
        "mpeg2_d3d11va",
        "mpeg2_dxva2",
        "vc1_d3d11va",
        "vc1_dxva2",
        "vp9_d3d11va",
        "vp9_dxva2",
        "wmv3_d3d11va",
        "wmv3_dxva2"
      ],
      "protocolsComment": [
        "udp carries nothing here. The Meson port is FFmpeg 8.1.2, whose",
        "tls_schannel.c calls ff_udp_get_last_recv_addr outside the",
        "CONFIG_DTLS_PROTOCOL guard, so enabling Schannel without the udp",
        "protocol leaves the symbol undefined and libmpv fails to link. 9.0.1",
        "guards it, which is why every other platform resolves UDP_PROTOCOL to",
        "0 and links. Drop this when Windows moves off the port."
      ],
      "protocols": [
        "udp"
      ]
    }
  },
