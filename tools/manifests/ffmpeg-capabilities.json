    "macos": {
      "gpl": false,
      "configureFlags": [
        "--enable-network",
        "--enable-gnutls",
        "--enable-audiotoolbox",
        "--enable-videotoolbox"
      ],
      "hardwareAccelerators": [
        "av1_videotoolbox",
