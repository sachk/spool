{
  "schemaVersion": 1,
  "requiredDisableFlags": [
    "--disable-everything",
    "--disable-gpl",
    "--disable-version3",
    "--disable-nonfree",
    "--disable-autodetect"
  ],
  "commonConfigureFlags": [
    "--disable-programs",
    "--disable-doc",
    "--disable-debug",
    "--disable-avdevice"
  ],
  "libraries": [
    "avcodec",
    "avfilter",
    "avformat",
    "avutil",
    "swresample",
    "swscale"
  ],
  "comment": [
    "protocols must keep http, https, tcp and tls even though libcurl, not",
    "FFmpeg, performs every network transfer. lavf's HLS demuxer resolves a",
    "segment URL with avio_find_protocol_name() before it ever reaches the",
    "io_open callback mpv points at libcurl, so a build without the https",
    "protocol registered fails every transcoded stream with \"https or dtls",
    "protocol not found\" while direct play keeps working."
  ],
  "protocols": [
    "file",
    "http",
    "https",
    "pipe",
    "tcp",
    "tls"
  ],
  "demuxers": [
