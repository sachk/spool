{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "JELLYFIN_NATIVE_WEBOS": "OFF"
      }
    },
    {
      "name": "linux-dev",
      "inherits": "native-base",
      "binaryDir": "${sourceDir}/build/linux-dev/app",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "JELLYFIN_NATIVE_DEV_BUILD": "ON"
      }
    },
    {
      "name": "linux-release",
      "inherits": "native-base",
      "binaryDir": "${sourceDir}/build/linux-release/app",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "JELLYFIN_NATIVE_DEV_BUILD": "OFF"
      }
    },
    {
      "name": "macos-release",
      "inherits": "native-base",
      "binaryDir": "${sourceDir}/build/macos/app",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "webos-static",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/webos/app-static",
      "toolchainFile": "${sourceDir}/tools/webos-native/qt6-webos-toolchain.cmake",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_FIND_ROOT_PATH": "$env{WEBOS_SDK_ROOT}/arm-webos-linux-gnueabi/sysroot;${sourceDir}/build/qt6-611-target-static-install",
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/qt6-611-target-static-install",
        "JELLYFIN_NATIVE_WEBOS": "ON",
        "MPV_WEBOS_BUILD_DIR": "${sourceDir}/mpv_webos/build/webos-libmpv",
        "QT_HOST_PATH": "${sourceDir}/build/qt6-611-host-install"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-dev",
      "configurePreset": "linux-dev"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    },
    {
      "name": "webos-static",
      "configurePreset": "webos-static"
    }
  ]
}
