{
  "id": "com.codex.jellyfinwebosnative",
  "version": "@VERSION@",
  "vendor": "Codex",
  "type": "native",
  "main": "bin/jellyfin-native",
  "title": "Jellyfin Native",
  "icon": "icon.png",
  "largeIcon": "icon.png",
  "appDescription": "Native Qt Quick Jellyfin client for LG webOS using libmpv and Starfish.",
  "tileSize": "normal",
  "supportTouchMode": "full",
  "spinnerOnLaunch": false,
  "visible": true,
  "removable": true,
  "noSplashOnLaunch": true,
  "inspectable": true,
  "transparent": false,
  "handlesRelaunch": true,
  "requiredPermissions": [
    "application.operation",
    "ime.operation",
    "media",
    "media.pipeline"
  ],
  "requiredMemory": 300,
  "nativeLifeCycleInterfaceVersion": 2
}
