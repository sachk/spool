#!/bin/sh

APP_ID="com.sachk.tern"
APP_DIR="/media/developer/apps/usr/palm/applications/$APP_ID"
if [ -x "$APP_DIR/bin/jellyfin-native.real" ]; then
  APP_BIN="$APP_DIR/bin/jellyfin-native.real"
else
  APP_BIN="$APP_DIR/bin/jellyfin-native"
fi

for LEGACY in \
  "/var/luna-service2/roles.d/$APP_ID.app.json" \
  "/var/luna-service2/client-permissions.d/$APP_ID.app.json" \
  "/var/luna-service2/manifests.d/$APP_ID.manifest.json"; do
  rm -f "$LEGACY"
done

mkdir -p /var/palm/ls2-dev/roles/pub /var/palm/ls2-dev/roles/prv 2>/dev/null

cat > "/var/palm/ls2-dev/roles/pub/$APP_ID.json" <<ROLE
{
  "role": {
    "exeName":"$APP_BIN",
    "type": "regular",
    "allowedNames": ["com.webos.media.client.*","com.webos.rm.client.*","com.webos.pipeline.*","com.webos.pipe.avmuteclient.*","com.webos.vt.*","com.webos.chromium.media.*",""]
  },
  "permissions": [
    {"service":"com.webos.media.client.*","outbound":["com.webos.media"],"inbound":["com.webos.media"]},
    {"service":"com.webos.rm.client.*","outbound":["com.webos.media"],"inbound":["com.webos.media"]},
    {"service":"com.webos.pipeline.*","outbound":["com.webos.pipelinectrl.*"],"inbound":["com.webos.pipelinectrl.*"]},
    {"service":"com.webos.pipe.avmuteclient.*","outbound":["com.webos.service.avmutemanager"],"inbound":[]},
    {"service":"com.webos.vt.*","outbound":["*"],"inbound":["*"]},
    {"service":"com.webos.chromium.media.*","outbound":["*"],"inbound":[]}
  ]
}
ROLE

cat > "/var/palm/ls2-dev/roles/prv/$APP_ID.json" <<ROLE
{
  "role": {
    "exeName":"$APP_BIN",
    "type": "regular",
    "allowedNames": ["com.webos.media.client.*","com.webos.rm.client.*","com.webos.pipeline.*","com.webos.pipe.avmuteclient.*","com.webos.vt.*","com.webos.chromium.media.*","com.webos.avconnector.*",""]
  },
  "permissions": [
    {"service":"com.webos.media.client.*","outbound":["com.webos.media"],"inbound":["com.webos.media"]},
    {"service":"com.webos.rm.client.*","outbound":["com.webos.media"],"inbound":["com.webos.media"]},
    {"service":"com.webos.pipeline.*","outbound":["com.webos.pipelinectrl.*"],"inbound":["com.webos.pipelinectrl.*"]},
    {"service":"com.webos.pipe.avmuteclient.*","outbound":["com.webos.service.avmutemanager"],"inbound":[]},
    {"service":"com.webos.vt.*","outbound":["*"],"inbound":["*"]},
    {"service":"com.webos.chromium.media.*","outbound":["*"],"inbound":[]},
    {"service":"com.webos.avconnector.*","outbound":["com.webos.service.videooutput","com.webos.service.audio","com.webos.service.config"],"inbound":[]}
  ]
}
ROLE

ls2-control scan-services 2>/dev/null || true

exit 0
