#!/bin/sh

APP_ID="com.sachk.tern"
APP_BIN="/media/developer/apps/usr/palm/applications/$APP_ID/bin/jellyfin-native"

for DIR in /var/palm/ls2-dev/roles/pub /var/palm/ls2-dev/roles/prv; do
  mkdir -p "$DIR" 2>/dev/null
  cat > "$DIR/$APP_ID.json" <<ROLE
{
    "role": {
    "exeName":"$APP_BIN",
    "type": "regular",
    "allowedNames": ["com.webos.media.client.*","com.webos.rm.client.*","com.webos.pipeline.*","com.webos.pipe.avmuteclient.*","com.webos.vt.*","com.webos.chromium.media.*","com.webos.avconnector.*","com.webos.service.ime.client.*","$APP_ID",""]
    },
    "permissions": [
        {"service":"com.webos.media.client.*","outbound":["com.webos.media"],"inbound":["com.webos.media"]},
        {"service":"com.webos.rm.client.*","outbound":["com.webos.media"],"inbound":["com.webos.media"]},
        {"service":"com.webos.pipeline.*","outbound":["com.webos.pipelinectrl.*"],"inbound":["com.webos.pipelinectrl.*"]},
        {"service":"com.webos.pipe.avmuteclient.*","outbound":["com.webos.service.avmutemanager"],"inbound":[]},
        {"service":"com.webos.vt.*","outbound":["*"],"inbound":["*"]},
        {"service":"com.webos.chromium.media.*","outbound":["*"],"inbound":[]},
        {"service":"com.webos.avconnector.*","outbound":["com.webos.service.videooutput","com.webos.service.audio","com.webos.service.config"],"inbound":[]},
        {"service":"com.webos.service.ime.client.*","outbound":["com.webos.service.ime"],"inbound":["com.webos.service.ime"]},
        {"service":"$APP_ID","outbound":["*"],"inbound":[]}
    ]
}
ROLE
done

mkdir -p /var/luna-service2/roles.d 2>/dev/null
cat > "/var/luna-service2/roles.d/$APP_ID.app.json" <<ROLE
{
  "exeName": "$APP_BIN",
  "type": "regular",
  "allowedNames": ["$APP_ID","com.webos.pipeline.*","com.webos.pipelinectrl.*","com.webos.media.client.*","com.webos.rm.client.*","com.webos.pipe.avmuteclient.*","com.webos.vt.*","com.webos.chromium.media.*","com.webos.avconnector.*","com.webos.service.ime.client.*",""],
  "trustLevel": "dev",
  "permissions": [
    {"service":"$APP_ID","outbound":["*"]},
    {"service":"com.webos.pipeline.*","outbound":["com.webos.pipelinectrl.*"],"inbound":["com.webos.pipelinectrl.*"]},
    {"service":"com.webos.media.client.*","outbound":["com.webos.media"],"inbound":["com.webos.media"]},
    {"service":"com.webos.rm.client.*","outbound":["com.webos.media"],"inbound":["com.webos.media"]},
    {"service":"com.webos.pipe.avmuteclient.*","outbound":["com.webos.service.avmutemanager"]},
    {"service":"com.webos.vt.*","outbound":["*"],"inbound":["*"]},
    {"service":"com.webos.chromium.media.*","outbound":["*"]},
    {"service":"com.webos.avconnector.*","outbound":["com.webos.service.videooutput","com.webos.service.audio","com.webos.service.config"]},
    {"service":"com.webos.service.ime.client.*","outbound":["com.webos.service.ime"],"inbound":["com.webos.service.ime"]}
  ]
}
ROLE

mkdir -p /var/luna-service2/client-permissions.d 2>/dev/null
cat > "/var/luna-service2/client-permissions.d/$APP_ID.app.json" <<PERM
{
  "$APP_ID":["public","media","all"],
  "com.webos.pipeline.*":["public","media","all"],
  "com.webos.pipelinectrl.*":["public","media","all"],
  "com.webos.media.client.*":["public","media","all"],
  "com.webos.rm.client.*":["public","media","all"],
  "com.webos.pipe.avmuteclient.*":["public","media","all"],
  "com.webos.vt.*":["public","media","all"],
  "com.webos.chromium.media.*":["public","media","all"],
  "com.webos.avconnector.*":["public","media","all"],
  "com.webos.service.ime.client.*":["public","media","all"]
}
PERM

mkdir -p /var/luna-service2/manifests.d 2>/dev/null
cat > "/var/luna-service2/manifests.d/$APP_ID.manifest.json" <<MANIFEST
{
  "id": "$APP_ID",
  "version": "1.0.0",
  "roleFiles": ["/var/luna-service2/roles.d/$APP_ID.app.json"],
  "clientPermissionFiles": ["/var/luna-service2/client-permissions.d/$APP_ID.app.json"],
  "roleFilesPub": ["/var/palm/ls2-dev/roles/pub/$APP_ID.json"],
  "roleFilesPrv": ["/var/palm/ls2-dev/roles/prv/$APP_ID.json"]
}
MANIFEST

ls2-control scan-services 2>/dev/null || true
killall -HUP ls-hubd 2>/dev/null || true

exit 0
